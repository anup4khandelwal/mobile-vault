#!/data/data/com.termux/files/usr/bin/env bash
# Wrapper so `vault <cmd>` works without typing `python3 -m vault.cli`.
# Resolves the repo root relative to this script, so it works regardless of cwd.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}"
exec python3 -m vault.cli --config "${VAULT_CONFIG:-$HOME/vault/config.toml}" "$@"
